# Copie este arquivo para ".env" e ajuste os valores.
DATABASE_URL="mysql://cyber:cyber123@localhost:3306/cyberacademy"
# Mínimo 32 caracteres. Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-com-no-minimo-32-caracteres"
PORT=3001

# ---------- Moderação de conteúdo ----------
# Chave GRATUITA do Google Gemini: https://aistudio.google.com/apikey
# Deixe vazio para usar apenas as regras locais (sem IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Máximo de publicações (tópicos/comentários) por usuário por minuto
POST_RATE_LIMIT_PER_MIN=6
